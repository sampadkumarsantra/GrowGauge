generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  fpo_rep
  facilitator
  admin
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  name           String?
  passwordHash   String?
  role           UserRole       @default(fpo_rep)
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime       @default(now())
  lastLoginAt    DateTime?

  accounts Account[]
  sessions Session[]
  submissions FPOSubmission[]   @relation("UserSubmissions")

  @@map("User")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("Account")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("Session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("VerificationToken")
}

model AuthRateLimit {
  id          String   @id @default(uuid())
  kind        String
  key         String
  count       Int      @default(1)
  windowStart DateTime @default(now())
  lastAttempt DateTime @default(now())

  @@unique([kind, key])
  @@map("AuthRateLimit")
}

model FPOSubmission {
  id                           String        @id @default(uuid())
  accessToken                  String        @unique
  fpoGroupId                   String?
  fpoName                      String
  state                        String
  district                     String
  registrationType             String
  activeMembers                Int
  members2YrAgo                Int
  revenueYear1                 Float
  revenueYear2                 Float?
  revenueYear3                 Float?
  costYear1                    Float
  costYear2                    Float?
  costYear3                    Float?
  products                     String
  activeBuyersCount            Int
  contractSalesPct             Float
  estimatedPriceRealizationPct Float?
  auditedAccounts              Boolean
  agmCountLastYear             Int
  boardMeetingsLastYear        Int
  email                        String?
  optedIntoLeaderboard         Boolean       @default(false)
  facilitatorId                String?
  userId                       String?
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt
  facilitator                  User?         @relation("FacilitatorSubmissions", fields: [facilitatorId], references: [id], onDelete: SetNull)
  owner                        User?         @relation("UserSubmissions", fields: [userId], references: [id], onDelete: SetNull)
  roadmapItems                 RoadmapItem[]
  scoreResult                  ScoreResult?

  @@index([fpoGroupId])
  @@index([facilitatorId])
  @@index([userId])
  @@index([state, district, optedIntoLeaderboard])
}

model RoadmapItem {
  id                   String        @id @default(uuid())
  submissionId         String
  submission           FPOSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  stageLabel           String
  actionText           String
  targetFactor         String
  estimatedScoreImpact Float
  completed            Boolean       @default(false)
  completedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([submissionId])
}

model SchemeReference {
  id              String   @id @default(uuid())
  name            String   @unique
  eligibilityTags String
  description     String
  link            String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LenderTypeReference {
  id              String   @id @default(uuid())
  lenderType      String   @unique
  minBandRequired String
  description     String
  typicalUseCase  String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ScoreResult {
  id                    String        @id @default(uuid())
  submissionId          String        @unique
  submission            FPOSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  overallScore          Float
  band                  String
  membershipScore       Float
  revenueStabilityScore Float
  costEfficiencyScore   Float
  diversificationScore  Float
  marketLinkageScore    Float
  governanceScore       Float
  narrativeSummary      String
  suggestions           String
  dataCompletenessFlag  Boolean
  calculatedAt          DateTime      @default(now())
}
