{
  "name": "growgauge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:db": "node scripts/dev-db.mjs",
    "build": "node -e \"if (process.env.DATABASE_URL) { require('child_process').execSync('npx prisma migrate deploy', { stdio: 'inherit' }) } else { console.warn('[build] DATABASE_URL not set - skipping prisma migrate deploy') }\" && next build",
    "start": "next start",
    "lint": "next lint",
    "icons": "tsx scripts/generate-icons.ts",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@react-pdf/renderer": "^4.2.2",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "5.10.0",
    "lucide-react": "^0.475.0",
    "next": "^14.2.23",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^7.0.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "^18.4.0-beta.17",
    "postcss": "^8.5.1",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
