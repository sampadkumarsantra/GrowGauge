# ─── Database ───────────────────────────────────────────────────────────────
# Production: Vercel Postgres / Neon connection string.
# Local dev: a local Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5432/growgauge?sslmode=disable"

# ─── App ─────────────────────────────────────────────────────────────────────
# Public origin used in emails and absolute links. Set to the deployed origin
# in production (e.g. https://growgauge.in).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Authentication (NextAuth) ───────────────────────────────────────────────
# Required. Generate one with: npx openssl rand -base64 32  (or `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`)
AUTH_SECRET=""

# Google OAuth (optional):
# When both GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are set, "Continue with
# Google" appears on the login/register pages and the provider is registered.
# Create the OAuth Client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# Used for verification + password-reset emails. Without these, mail is never
# truly delivered: in production email flows are unavailable and in dev the
# messages (with their links) are logged to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="GrowGauge <noreply@growgauge.in>"

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Authenticated endpoints rate-limit by email/IP using the Postgres
# `AuthAttempt` table (same pool as DATABASE_URL by default). Set a separate
# Upstash Redis REST URL (https, no auth needed) or a secondary Postgres to
# harden this further. When unset, the DATABASE_URL pool is used.
RATE_LIMIT_REDIS_REST_URL=""
RATE_LIMIT_DB=""