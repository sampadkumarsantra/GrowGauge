# ─── Database ───────────────────────────────────────────────────────────────
# Production: Vercel Postgres / Neon connection string.
# Local dev: a local Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5432/growgauge?sslmode=disable"

# ─── App ─────────────────────────────────────────────────────────────────────
# Public origin used in share links and the PDF report. Set to the deployed
# origin in production (e.g. https://growgauge.in).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Auth (NextAuth) ─────────────────────────────────────────────────────────
# 32+ byte random secret. Generate with: openssl rand -base64 32
# Keep stable across restarts and deployments to preserve sessions.
AUTH_SECRET=""
# Canonical site origin used by NextAuth (http://localhost:3000 in dev).
AUTH_URL="http://localhost:3000"

# ─── Google OAuth (optional) ────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Allowed redirect URI: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Email (SMTP) ───────────────────────────────────────────────────────────
# When unset, verification/reset links are logged to the dev console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""